generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RoleName {
  SUPER_ADMIN
  COLLEGE_ADMIN
  DEPT_HEAD
  COORDINATOR
  TEACHER
  STUDENT
  MODERATOR
}

enum TimetableStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum EntryType {
  REGULAR
  EXTRA
  SUBSTITUTE
  CANCELLED
}

enum SubjectType {
  THEORY
  PRACTICAL
  TUTORIAL
  SEMINAR
  LAB
}

enum ClassroomType {
  CLASSROOM
  LAB
  SEMINAR_HALL
  AUDITORIUM
}

enum NotificationType {
  TIMETABLE_PUBLISHED
  TIMETABLE_UPDATED
  CLASS_CANCELLED
  CLASS_RESCHEDULED
  TEACHER_CHANGED
  NEW_MESSAGE
  SYSTEM
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String?
  fullName     String
  phone        String?
  avatarUrl    String?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  userRoles            UserRole[]
  teacherProfile       TeacherProfile?
  studentProfile       StudentProfile?
  refreshTokens        RefreshToken[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  createdTimetables    TimetableVersion[]  @relation("CreatedBy")
  publishedTimetables  TimetableVersion[]  @relation("PublishedBy")
  timetableApprovals   TimetableApproval[]
  teacherEntries       TimetableEntry[]    @relation("TeacherEntries")
  substituteEntries    TimetableEntry[]    @relation("SubstituteEntries")
  headOfDepartments    Department[]
}

model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  description String?
  userRoles   UserRole[]
}

model UserRole {
  id           String   @id @default(uuid())
  userId       String
  roleId       String
  departmentId String?
  grantedAt    DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role        @relation(fields: [roleId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  @@unique([userId, roleId, departmentId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model College {
  id        String   @id @default(uuid())
  name      String
  domain    String?
  createdAt DateTime @default(now())

  departments      Department[]
  academicSessions AcademicSession[]
  classrooms       Classroom[]
}

model Department {
  id         String   @id @default(uuid())
  collegeId  String
  name       String
  code       String
  headUserId String?
  createdAt  DateTime @default(now())

  college           College            @relation(fields: [collegeId], references: [id])
  head              User?              @relation(fields: [headUserId], references: [id])
  courses           Course[]
  userRoles         UserRole[]
  timetableVersions TimetableVersion[]
  teacherProfiles   TeacherProfile[]

  @@unique([collegeId, code])
}

model AcademicSession {
  id        String   @id @default(uuid())
  collegeId String
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  college           College            @relation(fields: [collegeId], references: [id])
  sections          Section[]
  timetableVersions TimetableVersion[]
  holidays          Holiday[]
}

model Course {
  id            String   @id @default(uuid())
  departmentId  String
  name          String
  code          String
  durationYears Int      @default(3)
  createdAt     DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id])
  subjects   Subject[]
  sections   Section[]

  @@unique([departmentId, code])
}

model Subject {
  id          String      @id @default(uuid())
  courseId    String
  name        String
  code        String
  semester    Int
  credits     Int         @default(3)
  weeklyHours Int         @default(3)
  type        SubjectType @default(THEORY)
  createdAt   DateTime    @default(now())

  course           Course           @relation(fields: [courseId], references: [id])
  timetableEntries TimetableEntry[]

  @@unique([courseId, code])
}

model Section {
  id                String   @id @default(uuid())
  courseId          String
  academicSessionId String
  semester          Int
  name              String
  createdAt         DateTime @default(now())

  course            Course          @relation(fields: [courseId], references: [id])
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  studentProfiles   StudentProfile[]
  timetableVersions TimetableVersion[]
}

model Classroom {
  id        String        @id @default(uuid())
  collegeId String
  name      String
  capacity  Int
  type      ClassroomType @default(CLASSROOM)
  resources Json?
  createdAt DateTime      @default(now())

  college          College          @relation(fields: [collegeId], references: [id])
  timetableEntries TimetableEntry[]
}

model TeacherProfile {
  userId         String   @id
  departmentId   String?
  maxWeeklyHours Int      @default(20)
  createdAt      DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id])
}

model StudentProfile {
  userId           String  @id
  sectionId        String?
  rollNumber       String?
  enrollmentNumber String?
  createdAt        DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  section Section? @relation(fields: [sectionId], references: [id])
}

model Holiday {
  id                String   @id @default(uuid())
  academicSessionId String
  date              DateTime
  name              String

  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id])
}

model TimetableVersion {
  id                String          @id @default(uuid())
  departmentId      String
  academicSessionId String
  sectionId         String
  versionNumber     Int
  status            TimetableStatus @default(DRAFT)
  createdById       String
  publishedAt       DateTime?
  publishedById     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  department      Department        @relation(fields: [departmentId], references: [id])
  academicSession AcademicSession   @relation(fields: [academicSessionId], references: [id])
  section         Section           @relation(fields: [sectionId], references: [id])
  createdBy       User              @relation("CreatedBy", fields: [createdById], references: [id])
  publishedBy     User?             @relation("PublishedBy", fields: [publishedById], references: [id])
  entries         TimetableEntry[]
  approvals       TimetableApproval[]
}

model TimetableEntry {
  id                  String    @id @default(uuid())
  timetableVersionId  String
  subjectId           String
  teacherId           String
  classroomId         String
  dayOfWeek           Int
  startTime           String
  endTime             String
  entryType           EntryType @default(REGULAR)
  substituteTeacherId String?
  createdAt           DateTime  @default(now())

  timetableVersion  TimetableVersion @relation(fields: [timetableVersionId], references: [id], onDelete: Cascade)
  subject           Subject          @relation(fields: [subjectId], references: [id])
  teacher           User             @relation("TeacherEntries", fields: [teacherId], references: [id])
  classroom         Classroom        @relation(fields: [classroomId], references: [id])
  substituteTeacher User?            @relation("SubstituteEntries", fields: [substituteTeacherId], references: [id])
}

model TimetableApproval {
  id                 String          @id @default(uuid())
  timetableVersionId String
  action             TimetableStatus
  actorId            String
  comment            String?
  actedAt            DateTime        @default(now())

  timetableVersion TimetableVersion @relation(fields: [timetableVersionId], references: [id])
  actor            User             @relation(fields: [actorId], references: [id])
}

model Notification {
  id          String           @id @default(uuid())
  userId      String
  type        NotificationType
  title       String
  body        String
  data        Json?
  readAt      DateTime?
  deliveredAt DateTime?
  createdAt   DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  ipAddress    String?
  occurredAt   DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])
}
